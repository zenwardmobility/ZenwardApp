# Zenward Platform — required environment variables (names only, no values).
# Copy to .env.local and fill in real local-development values — .env.local
# is gitignored (.gitignore: `.env*`) and must never be committed.
#
# All three are safe for the browser (NEXT_PUBLIC_*) — the publishable key
# relies entirely on RLS/RPC authorization, never a service-role/secret key
# (docs/security/application-auth-boundary.md).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=
